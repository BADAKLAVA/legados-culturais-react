# Banco PostgreSQL (preencha localmente ou configure no painel do Render)
DB_HOST=seu-host-postgresql
DB_PORT=5432
DB_NAME=nome-do-banco
DB_USER=usuario-do-banco
DB_PASSWORD=senha-do-banco
DB_SSLMODE=require

# Gere uma chave aleatória longa. Não compartilhe nem envie ao GitHub.
APP_KEY=troque-por-uma-chave-aleatoria-longa
APP_URL=https://seu-servico.onrender.com

# Opcional: envio de e-mails de recuperação de senha
RESEND_API_KEY=
RESEND_FROM=

# Google Drive (OAuth 2.0) - armazenamento privado dos arquivos
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
